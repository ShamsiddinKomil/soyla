#!/usr/bin/env bash
# Install once per clone: git config core.hooksPath scripts/git-hooks
# Format check + lint on staged Swift files, then the full test suite. Any non-zero rc blocks the commit.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
files=()
while IFS= read -r f; do files+=("$f"); done < <(git diff --cached --name-only --diff-filter=ACM -- '*.swift')
if [ "${#files[@]}" -gt 0 ]; then
  swiftformat --lint --quiet "${files[@]}" || { echo "pre-commit: swiftformat --lint failed (run: swiftformat <file>)" >&2; exit 1; }
  # swiftlint guards app code only (.swiftlint.yml `included`); explicit paths would override that, so filter here.
  app=(); for f in "${files[@]}"; do case "$f" in Sources/*|Tests/*) app+=("$f");; esac; done
  if [ "${#app[@]}" -gt 0 ]; then
    scripts/lint.sh lint --quiet --baseline .swiftlint.baseline "${app[@]}" || { echo "pre-commit: swiftlint failed" >&2; exit 1; }
  fi
fi
log=$(mktemp); trap 'rm -f "$log"' EXIT
scripts/test.sh > "$log" 2>&1; rc=$?
if [ "$rc" -ne 0 ]; then echo "pre-commit: scripts/test.sh failed (rc=$rc). Last lines:" >&2; tail -30 "$log" >&2; exit 1; fi
exit 0
