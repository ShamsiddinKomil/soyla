<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened runtime: the one exception Soyla needs is the microphone. No JIT, no unsigned code, no library
     validation opt-out, no DYLD_* environment: another process can't inject code and borrow Soyla's permissions. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
